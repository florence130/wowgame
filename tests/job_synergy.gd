extends "res://tests/job_combat.gd"
## Mechanism-focused tests: compare connected and disconnected skills, not just damage > 0.

func native_hit(sid: String, tgt: Unit = null) -> void:
	for attempt in 12:
		ready()
		var before := d.hp
		await cast(sid, tgt)
		if d.hp < before:
			return
	check(false, sid + " native hit retry exhausted")

func run() -> void:
	seed(711)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(out))
	fixture("warrior", "paladin")
	await native_hit("pd_oath_cut")
	await native_hit("pd_shield_bash")
	check(p.gauge("holy_power") == 3 and p.get_aura("pd_oath").is_empty(), "sword-to-shield grants three points and consumes the preparation")
	ready()
	var holy := p.gauge("holy_power")
	check(p.begin_cast(DB.spell("pd_radiant_strike", 1), d), "paladin spender starts")
	p.cancel_action()
	check(p.gauge("holy_power") == holy, "cancel before contact preserves unspent holy power")
	ready()
	p.begin_cast(DB.spell("pd_radiant_strike", 1), d)
	p._tick_action(0.21)
	check(p.gauge("holy_power") == 0, "paladin spender pays exactly at contact")
	ready()
	p.begin_cast(DB.spell("pd_riposte", 1), p)
	p.face_towards(d.position)
	d.deal_melee_damage(p, 100, "counter probe")
	check(p.gauge("holy_power") == 2 and not p.get_aura("pd_counter").is_empty(), "successful timed counter feeds and empowers the normal loop")
	fixture("warrior", "berserker")
	p.gauge_add("fury", 30)
	await native_hit("bk_bloodthirst")
	var fury := p.gauge("fury")
	await native_hit("bk_rend_slash")
	check(p.gauge("fury") == fury + 18 and p.get_aura("bk_flow").is_empty(), "bloodthirst returns an empowered eighteen-fury builder")
	fixture("mage", "dark_mage")
	p.gauge_add("ice_mark", 2)
	var fire := DB.spell("dm_flame_bolt", 1)
	check(is_equal_approx(p.cast_time(fire), 1.155), "one ice mark speeds fire by thirty percent")
	await native_hit("dm_flame_bolt")
	check(p.gauge("ice_mark") == 1 and p.gauge("ember") == 1, "fire consumes one ice mark and builds independent shadow fuel")
	p.gauge_add("ember", 2)
	await native_hit("dm_void_pulse")
	check(p.gauge("ice_mark") == 1 and p.gauge("ember") == 0, "shadow release spends only embers and preserves ice acceleration")
	p.gauge_clear("ice_mark")
	p.power = 0
	p.gcd = 0
	await cast("dm_frost_spike")
	check(p.power >= p.max_power * 0.27 and p.gauge("ice_mark") == 2, "ice recovers enough mana and marks for two ordinary fires")
	fixture("mage", "elementalist")
	await native_hit("el_water_bolt")
	await native_hit("el_water_bolt")
	check(p.gauge("tide") == 2 and not d.get_aura("el_wet").is_empty(), "water prepares both tide and a conductive target")
	await native_hit("el_lightning")
	check(p.gauge("tide") == 0 and not p.get_aura("el_return").is_empty(), "lightning actually spends tide and prepares water return")
	check(is_equal_approx(p.cast_time(DB.spell("el_water_bolt", 1)), 0.55), "lightning halves the return water cast")
	await native_hit("el_water_bolt")
	check(p.gauge("tide") == 2 and p.get_aura("el_return").is_empty(), "return water rebuilds exactly two tide and consumes its proc")
	fixture("priest", "radiant")
	p.hp = p.max_hp
	await cast("wh_wind_mend", p)
	check(p.gauge("bloom") == 0, "full-health wind heal cannot farm blooms")
	ready()
	await cast("wh_water_blessing", p)
	ready()
	await cast("wh_water_blessing", p)
	check(p.gauge("bloom") == 1, "refreshing the same water blessing cannot farm blooms")
	p.hp = p.max_hp * 0.4
	var before := p.hp
	ready()
	await cast("wh_wind_mend", p)
	check(p.gauge("bloom") == 2 and p.hp - before > p.max_hp * 0.135, "water improves effective wind healing and wind advances the light resource")
	p.gauge_add("bloom", 1)
	var light := DB.spell("wh_pure_light", 1)
	check(p.spell_cost(light) == 0 and p.cast_time(light) < 1.1, "three blooms make large light heal efficient and faster")
	ready()
	await cast("wh_pure_light", p)
	check(p.gauge("bloom") == 0, "efficient light consumes its complete preparation")
	fixture("priest", "shadow_priest")
	p.gauge_add("light", 40)
	p.gauge_add("bolt", 60)
	await cast("cl_thunder_brand", p)
	ready()
	await native_hit("cl_lightning_smash")
	check(p.gauge("light") == 0 and p.gauge("bolt") == 0 and not p.get_aura("cl_afterglow").is_empty(), "enchanted hammer spends both gauges and creates the light payoff")
	ready()
	check(p.check_cast(DB.spell("cl_light_guard", 1), p) == "", "afterglow permits protection with zero light")
	await cast("cl_light_guard", p)
	ready()
	check(p.check_cast(DB.spell("cl_radiant_mend", 1), p) != "" and p.get_aura("cl_afterglow").is_empty(), "choosing free guard consumes the free heal opportunity")
	fixture("rogue", "assassin")
	await native_hit("as_venomous_cut")
	p.power = 0
	d._tick_auras(3.01)
	check(p.power == 0, "poison alone grants no energy feedback")
	for attempt in 12:
		p.combo = 4
		p.combo_target = d
		ready()
		await cast("as_death_mark")
		if not d.get_aura("as_bleed").is_empty(): break
	p.power = 0
	d._tick_auras(3.01)
	check(p.power == 5, "poison on a bleeding target returns energy")
	p.combo = 4
	p.combo_target = d
	await native_hit("as_envenom")
	await native_hit("as_venomous_cut")
	check(p.combo == 2 and p.get_aura("as_edge").is_empty(), "poison finisher upgrades exactly one two-point builder")
	fixture("rogue", "duelist")
	check(p.power_type == "none" and p.max_power == 0, "spellblade has one resource instead of energy plus competing resonance")
	await native_hit("ms_shadow_bolt")
	await native_hit("ms_arcane_edge")
	check(p.gauge("resonance") == 30 and p.cast_time(DB.spell("ms_shadow_bolt", 1)) == 0, "magic-to-rapier builds thirty resonance and returns an instant spell")
	await native_hit("ms_shadow_bolt")
	await native_hit("ms_arcane_edge")
	await native_hit("ms_unbound")
	check(p.gauge("resonance") == 0 and not p.get_aura("ms_echo").is_empty(), "two connected pairs fund a finisher that restarts magic")
	fixture("gunner", "marksman")
	await native_hit("cannon_steady")
	await native_hit("cannon_steady")
	check(p.gauge("ammo") == 4 and p.gauge("aim") == 2, "two real shots spend bullets and ready the hand cannon")
	await native_hit("cannon_burst")
	check(p.gauge("ammo") == 2 and p.gauge("aim") == 0, "hand cannon spends two bullets plus two aim marks")
	p.gauge_clear("ammo")
	ready()
	p.begin_cast(DB.spell("cannon_reload", 1), p)
	p._tick_cast(0.61)
	p.stop_cast()
	check(p.gauge("ammo") == 3, "interrupted reload retains just its first three rounds")
	p.auto_shoot = true
	var target_hp := d.hp
	p._tick_auto(5)
	check(d.hp == target_hp and not p.auto_shoot, "gunner auto fire cannot bypass magazine management")
	fixture("gunner", "gadgeteer")
	await cast("mech_armor", p)
	p.in_combat = true
	p.gauge_add("heat", 72)
	p._tick_gauges(2)
	check(p.gauge("heat") == 72, "combat heat remains a deliberate temperature budget")
	await native_hit("mech_rail")
	check(p.gauge("heat") == 12 and not p.get_aura("mech_cooled").is_empty(), "rail releases heat and prepares the next piston")
	await native_hit("mech_piston")
	check(p.gauge("heat") == 30 and p.get_aura("mech_cooled").is_empty(), "piston heats again and consumes cooling feedback")
	# Guaranteed dodge: no resource, poison, proc or combo reward on a miss.
	fixture("rogue", "assassin")
	d.stats["dodge"] = 100
	await cast("as_venomous_cut")
	check(p.combo == 0 and d.get_aura("as_poison").is_empty(), "missed dagger strike grants neither combo nor poison")
	fixture("warrior", "paladin")
	p.model.play_skill_attack(0.18, 0.26, "shield")
	p.model.animate(0.18, {})
	check(p.model.skill_style == "shield" and p.model.elbow_l.rotation.x > -0.3, "shield animation reaches its extension at the gameplay contact time")
	p.model.play_attack(0)
	check(p.model.skill_style == "shield" and p.model.attack_t >= 0.18, "automatic attack cannot overwrite an active skill pose")
	p.cancel_action()
	check(p.model.attack_t < 0 and p.model.skill_style == "", "cancelling gameplay action also cancels its visual attack")
	fixture("rogue", "duelist")
	p.model.set_combat_ready(true)
	p.model.play_skill_attack(0.14, 0.2, "thrust")
	p.model.animate(0.14, {})
	check(p.model.weapon_main.global_basis.y.normalized().dot(p.forward_dir()) > 0.98, "rapier blade points toward the enemy at thrust contact")
	p.model.cancel_skill()
	p.model.animate(0.5, {"speed": 4.0})
	p.model.play_skill_attack(0.14, 0.2, "thrust")
	p.model.animate(0.339, {"speed": 4.0})
	var recovered_arm: Vector3 = p.model.arm_r.rotation
	p.model.animate(0.002, {"speed": 4.0})
	check(recovered_arm.distance_to(p.model.arm_r.rotation) < 0.08, "skill recovery blends into the active locomotion pose without an arm snap")
	p.model.play_skill_attack(0.14, 0.2, "thrust")
	p.model.animate(0.12, {})
	p._commit_skill(DB.spell("ms_arcane_edge", 1))
	p.model.impact_pause(0.025)
	check(is_equal_approx(p.model.attack_t, 0.14) and p.model.weapon_main.global_basis.y.normalized().dot(p.forward_dir()) > 0.98, "hit pause freezes actual contact instead of the previous anticipation frame")
	fixture("gunner", "marksman")
	p.model.set_ranged_mode(true)
	p.model.animate(0.2, {"aiming": true, "channel": true, "cast_animation": "reload"})
	check(p.model.elbow_l.rotation.x < -1.0, "aiming cannot overwrite the magazine reload animation")
	fixture("gunner", "gadgeteer")
	p.model.set_mech_armor(true)
	check(not p.model.weapon_main.visible and not p.model.weapon_ranged.visible, "deployed armor uses mounted weapons rather than a handheld ordinary sword")
	fixture("priest", "radiant")
	p.begin_cast(DB.spell("wh_water_blessing", 1), p)
	check(p.model.cast_release_t >= 0.0, "instant nonprojectile healing has a release gesture")
	fixture("warrior", "paladin")
	p.model.play_roll()
	p.model.animate(0.07, {})
	check(p.model.hips.global_position.y > 0.4, "quarter-roll rotates around the body center above the floor")
	p.model.play_roll()
	var roll_bounds := true
	for i in 18:
		p.model.animate(1.0 / 60.0, {})
		roll_bounds = roll_bounds and p.model.body.position.length() < 1.8 and p.model.head.global_position.y > -0.1
	check(roll_bounds and p.model.body.position.length() < 0.05, "complete roll never accumulates visual offset and returns to the character root")
	var report := FileAccess.open(out + "/synergy_v2.json", FileAccess.WRITE)
	report.store_string(JSON.stringify({"checks": checks, "failed": failed, "saved_character": false}, "\t"))
	report.close()
	print("SYNERGY DONE checks=", checks.size(), " failed=", failed)
	get_tree().quit(1 if failed else 0)
